# Pravah Worker Configuration
PORT=8000
HOST=0.0.0.0
WORKER_AUTH_SECRET=pravah-eval-secret-key-12345

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional direct OpenAI fallback
OPENAI_API_KEY=

# Set to true to use intelligent deterministic stub judge without calling external APIs (useful for offline testing)
MOCK_LLM=false

# Langfuse / OpenTelemetry Observability
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
